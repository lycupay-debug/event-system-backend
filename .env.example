# Feishu/Lark custom app credentials. Use your own values in the local, untracked .env file.
# Never put real credentials in this example file or commit them.
LARK_APP_ID=cli_your_app_id
LARK_APP_SECRET=replace_with_your_app_secret

# n8n production webhook forwarding. Keep the real token only in the server's untracked .env.
# Do not commit the real token or paste it into source code.
N8N_WEBHOOK_URL=https://n8n.lycupaynotion.top/webhook/feishu-bridge-serial-ingress-20261011-a84f6c2d
N8N_WEBHOOK_TOKEN=replace_with_rotated_X_Bridge_Token

# Python/SDK log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
