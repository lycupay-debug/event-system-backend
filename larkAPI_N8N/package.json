{
  "name": "n8n-nodes-lark-bitable",
  "version": "0.1.0",
  "description": "n8n community node for Feishu/Lark Bitable APIs",
  "license": "UNLICENSED",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "feishu",
    "lark",
    "bitable"
  ],
  "main": "dist/nodes/LarkBitable/LarkBitable.node.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.cjs && esbuild nodes/LarkBitable/LarkBitable.node.ts --bundle --platform=node --format=cjs --external:n8n-workflow --external:@larksuiteoapi/node-sdk --outfile=dist/nodes/LarkBitable/LarkBitable.node.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run typecheck && node --test test/*.test.cjs"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LarkBitableApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LarkBitable/LarkBitable.node.js"
    ]
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.72.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@lycupay-debug/lark-api": "file:../larkAPI",
    "esbuild": "0.25.5",
    "n8n-workflow": "^1.82.0",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.82.0"
  }
}
